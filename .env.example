# SOCIAL X-RAY Environment Variables
# Copy this file to .env.local and populate your Google Gemini API key.
# NEVER commit your actual .env or .env.local file to Git.

# Google Gemini API Key (Required for server-side AI forensic analysis)
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Google Gemini Model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
